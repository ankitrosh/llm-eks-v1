{
  "model": {
    "checkpoint_dir": "/models/model",
    "quantization": {
      "provider": "gptq",
      "options": {
        "bits": 8,
        "execution_backend": "marlin"
      }
    }
  },
  "pipeline": {
    "num_ranks": 2,
    "partition": "manual",
    "layer_counts": [
      14,
      14
    ],
    "memory": {
      "gpu_memory_gib": [
        20.0,
        20.0
      ],
      "reserve_gib": 1.0,
      "max_active_requests": 4,
      "max_total_tokens_per_request": 128
    }
  },
  "communication": {
    "backend": "nccl",
    "codec": "identity"
  },
  "scheduler": {
    "mode": "continuous",
    "policy": "fcfs",
    "max_requests_per_batch": 4,
    "max_batch_tokens": 1024,
    "max_queue_requests": 32,
    "max_wait_ms": 0
  }
}
